# Copy to deploy/.env. LAN-only tool: these are plain values, no secrets manager.

# Basic auth for the web UI (not stored in the DB, so a corrupt DB cannot lock you out).
AUTH_USER=relay
AUTH_PASS=change-me

# SQLite file inside the container. Backed by the relay-data volume.
DB_PATH=/data/app.db

# Private key used to SSH to the Synology, mounted read-only into the container.
NAS_SSH_KEY_PATH=/keys/nas_key
# Host-side path of that key file, bind-mounted by docker-compose.
NAS_SSH_KEY_PATH_HOST=/home/pi/.ssh/nas_key

# debug | info | warn | error
LOG_LEVEL=info

# Port the Go process listens on behind nginx. Rarely worth changing.
PORT=8080
